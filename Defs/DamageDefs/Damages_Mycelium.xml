<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Explosion damage that plants mycelium binds instead of harming health directly. -->
  <DamageDef>
    <defName>FM_MyceliumSnare</defName>
    <label>mycelium</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <deathMessage>{0} was consumed by creeping mycelium.</deathMessage>
    <hediff>FM_MyceliumBind</hediff>
    <isExplosive>true</isExplosive>
    <makesBlood>false</makesBlood>
    <defaultDamage>8</defaultDamage>
    <explosionCellFleck>BlastExtinguisher</explosionCellFleck>
    <explosionColorCenter>(0.85, 0.5, 0.65, 0.4)</explosionColorCenter>
    <explosionColorEdge>(0.6, 0.3, 0.45, 0.1)</explosionColorEdge>
    <soundExplosion>Explosion_Smoke</soundExplosion>
    <combatLogRules>Damage_Bomb</combatLogRules>
  </DamageDef>

</Defs>
