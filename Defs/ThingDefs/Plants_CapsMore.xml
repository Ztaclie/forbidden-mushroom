<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="PlantBase">
    <defName>FM_Plant_Toilcap</defName>
    <label>toilcap</label>
    <description>A broad, ridged mushroom the color of worn leather. Workers who chew it say the day goes by faster and the work does itself.</description>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Nutrition>0.1</Nutrition>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/FM_Toilcap</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <selectable>true</selectable>
    <pathCost>14</pathCost>
    <ingestible />
    <plant>
      <immatureGraphicPath>Things/Plant/FM_Toilcap_Immature</immatureGraphicPath>
      <fertilityMin>0.3</fertilityMin>
      <fertilitySensitivity>0.3</fertilitySensitivity>
      <growMinGlow>0</growMinGlow>
      <growOptimalGlow>0</growOptimalGlow>
      <dieIfLeafless>true</dieIfLeafless>
      <neverBlightable>true</neverBlightable>
      <harvestTag>Standard</harvestTag>
      <harvestedThingDef>FM_Toilcap</harvestedThingDef>
      <harvestYield>6</harvestYield>
      <sowTags>
        <li>Ground</li>
        <li>Hydroponic</li>
      </sowTags>
      <sowResearchPrerequisites>
        <li>FM_LaborFungi</li>
      </sowResearchPrerequisites>
      <topWindExposure>0.05</topWindExposure>
      <growDays>8</growDays>
      <visualSizeRange>0.5~1.0</visualSizeRange>
      <wildOrder>2</wildOrder>
      <purpose>Misc</purpose>
    </plant>
  </ThingDef>

