<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="PlantBase">
    <defName>FM_Plant_Ragecap</defName>
    <label>ragecap</label>
    <description>A tall, flared mushroom the color of old blood. Its flesh is dense with something that makes the heart pound just from handling it.</description>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Nutrition>0.1</Nutrition>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/FM_Ragecap</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <selectable>true</selectable>
    <pathCost>14</pathCost>
    <ingestible />
    <plant>
      <immatureGraphicPath>Things/Plant/FM_Ragecap_Immature</immatureGraphicPath>
      <fertilityMin>0.3</fertilityMin>
      <fertilitySensitivity>0.3</fertilitySensitivity>
      <growMinGlow>0</growMinGlow>
      <growOptimalGlow>0</growOptimalGlow>
      <dieIfLeafless>true</dieIfLeafless>
      <neverBlightable>true</neverBlightable>
      <harvestTag>Standard</harvestTag>
      <harvestedThingDef>FM_Ragecap</harvestedThingDef>
      <harvestYield>6</harvestYield>
      <sowTags>
        <li>Ground</li>
        <li>Hydroponic</li>
      </sowTags>
      <sowResearchPrerequisites>
        <li>FM_CombatFungi</li>
      </sowResearchPrerequisites>
      <topWindExposure>0.05</topWindExposure>
      <growDays>8</growDays>
      <visualSizeRange>0.5~1.0</visualSizeRange>
      <wildOrder>2</wildOrder>
      <purpose>Misc</purpose>
    </plant>
  </ThingDef>

