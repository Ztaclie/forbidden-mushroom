<Defs>

  <HediffDef>
    <defName>FM_Toilcap_High</defName>
    <hediffClass>Hediff_High</hediffClass>
    <label>toilcap drive</label>
    <labelNoun>a toilcap drive</labelNoun>
    <description>A relentless drive from toilcap. Work goes faster across the board.</description>
    <defaultLabelColor>(0.75,0.5,0.2)</defaultLabelColor>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1.000</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <label>active</label>
        <minSeverity>0</minSeverity>
        <hungerRateFactor>1.8</hungerRateFactor>
        <statOffsets>
        </statOffsets>
        <statFactors>
          <WorkSpeedGlobal>1.3</WorkSpeedGlobal>
          <RestFallRateFactor>1.6</RestFallRateFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

