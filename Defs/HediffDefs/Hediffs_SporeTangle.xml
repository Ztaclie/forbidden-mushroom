<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Lighter version of the mycelium bind. Each tangle halves movement and raises hunger a little;
       several tangles on one pawn bring them down so they can be captured. -->
  <HediffDef ParentName="InjuryBase">
    <defName>FM_SporeTangle</defName>
    <label>spore tangle</label>
    <labelNoun>a spore tangle</labelNoun>
    <labelNounPretty>spore tangle on {1}</labelNounPretty>
    <description>Spores have taken root in this part and sent threads through it, slowing it down while they feed. Several tangles will bring a victim to the ground. Tending cuts the threads away.</description>
    <defaultLabelColor>(0.85, 0.5, 0.65)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_TendDuration">
        <labelTendedWell>cut free</labelTendedWell>
        <labelTendedWellInner>cut free</labelTendedWellInner>
        <labelSolidTendedWell>cut free</labelSolidTendedWell>
      </li>
    </comps>
    <injuryProps>
      <painPerSeverity>0.003</painPerSeverity>
      <bleedRate>0</bleedRate>
      <averagePainPerSeverityPermanent>0</averagePainPerSeverityPermanent>
      <destroyedLabel>Consumed</destroyedLabel>
      <alwaysUseDestroyedLabel>true</alwaysUseDestroyedLabel>
    </injuryProps>
    <stages>
      <li>
        <label>tangled</label>
        <becomeVisible>true</becomeVisible>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <postFactor>0.5</postFactor>
          </li>
        </capMods>
        <hungerRateFactorOffset>0.3</hungerRateFactorOffset>
      </li>
    </stages>
  </HediffDef>

</Defs>
